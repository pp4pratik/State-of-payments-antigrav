# Google Drive Configuration
# Optional: JSON object string mapping table names to Google Drive File IDs
# Example: VITE_GDRIVE_FILE_IDS='{"monthly_trend": "1abc...", "app_stats": "1xyz..."}'
VITE_GDRIVE_FILE_IDS=

# Optional: Base URL for JSON data hosting. Defaults to '/state-of-payments/data'
VITE_DATA_BASE_URL=

# Optional - pageview/session analytics via PostHog. Leave blank to disable.
VITE_POSTHOG_KEY=

# Optional - Legacy Supabase / Airtable credentials (if running export script)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
AIRTABLE_TOKEN=
